{
  "name": "xmd-cli",
  "version": "0.1.0",
  "description": "Convert a tweet + its conversation into Markdown, with image OCR, diagram-to-mermaid, and AI alt-text via a local Playwright session and claude -p.",
  "type": "module",
  "bin": {
    "xmd": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "login": "tsx src/cli.tsx login",
    "browsers": "playwright install chromium",
    "postinstall": "playwright install chromium",
    "categorize": "tsx scripts/categorize.ts",
    "report": "tsx scripts/generate-report.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "guard:ts": "scripts/guard-typescript-only.sh",
    "test": "node --import tsx --test scripts/test-*.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "twitter",
    "x",
    "markdown",
    "playwright",
    "claude",
    "ocr",
    "mermaid"
  ],
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "css-tree": "^3.2.1",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "jsdom": "^26.1.0",
    "mdast-util-from-markdown": "^2.1.0",
    "playwright": "^1.48.0",
    "react": "^18.3.1",
    "sharp": "^0.35.5",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@types/css-tree": "^3.2.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "packageManager": "pnpm@10.24.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ytspar/xmd.git"
  },
  "homepage": "https://github.com/ytspar/xmd#readme",
  "bugs": {
    "url": "https://github.com/ytspar/xmd/issues"
  }
}
